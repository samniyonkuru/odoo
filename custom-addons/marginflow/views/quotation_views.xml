<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- List view -->
    <record id="view_marginflow_quotation_list" model="ir.ui.view">
        <field name="name">marginflow.quotation.list</field>
        <field name="model">marginflow.quotation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="sales_price"/>
                <field name="material_cost"/>
                <field name="production_cost"/>
                <field name="total_cost"/>
                <field name="margin"/>
                <field name="margin_percent"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_marginflow_quotation_form" model="ir.ui.view">
        <field name="name">marginflow.quotation.form</field>
        <field name="model">marginflow.quotation</field>
        <field name="arch" type="xml">
            <form string="Quotation">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="customer_id"/>
                        <field name="sales_price"/>
                        <field name="material_cost"/>
                        <field name="production_cost"/>
                        <field name="total_cost"/>
                        <field name="margin"/>
                        <field name="margin_percent"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_marginflow_quotation" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">marginflow.quotation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_marginflow_root"
        name="MarginFlow"
        sequence="10"
        web_icon="marginflow,static/description/icon.png"
        />

    <menuitem
        id="menu_marginflow_quotation"
        name="Quotations"
        parent="menu_marginflow_root"
        action="action_marginflow_quotation"
        sequence="10"
        />
</odoo>
